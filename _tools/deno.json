{
  "nodeModulesDir": "auto",
  "imports": {
    "@w6w/types": "../../core/packages/types/mod.ts",
    "@w6w/runtime": "../../core/packages/runtime/mod.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "convert": "deno run --allow-net --allow-read --allow-write --allow-env n8n-to-w6w.ts",
    "icons": "deno run --allow-read icon-legibility.ts check",
    "icons:fix": "deno run --allow-read --allow-write icon-legibility.ts fix",
    "icons:normalize": "deno run --allow-read --allow-write --allow-run --allow-env icon-normalize.ts --all",
    "coverage": "deno run --no-check -A output-coverage.ts",
    "test": "deno test -A --unstable-worker-options audit.test.ts app-paths.test.ts output-coverage.test.ts sync-shared.test.ts poll-kit.test.ts poll-kit-sandbox.test.ts triggers-coverage.test.ts"
  },
  "fmt": {
    "exclude": [
      "_fixtures/entry-import-broken/assets",
      "_fixtures/network-allow-wildcard-apex/assets",
      "_fixtures/param-unread/assets",
      "_fixtures/param-read-via-helper/assets",
      "_fixtures/group-childless/assets",
      "_fixtures/n8n-vocabulary/assets"
    ]
  }
}
