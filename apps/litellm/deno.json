{
  "name": "@w6w-apps/litellm",
  "exports": "./index.ts",
  "imports": {
    "@w6w/types": "../../../core/packages/types/mod.ts",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "test": "deno test -A tests/",
    "check": "deno check index.ts auth/ tests/",
    "fmt": "deno fmt index.ts auth/ tests/",
    "lint": "deno lint index.ts auth/ tests/",
    "validate": "deno run --no-check -A --config ./deno.json ../../_tools/audit.ts litellm"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
